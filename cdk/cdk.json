{
  "app": "python app.py",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "requirements.txt",
      "**/__init__.py",
      "python/__pycache__",
      "tests"
    ]
  },
  "context": {
    "aws-cdk:enableDiffNoFail": "true",
    "@aws-cdk/aws-iam:minimizePolicies": "true",
    "@aws-cdk/core:validateSnapshotRemovalPolicy": "true",
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": "true",
    "@aws-cdk/aws-sns-subscriptions:restrictRecipientEmails": "true"
  }
}
